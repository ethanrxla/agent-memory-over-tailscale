# Per-device transcript watcher (systemd --user unit).
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/agent-memory-watcher.service ~/.config/systemd/user/
#   systemctl --user edit agent-memory-watcher   # set Environment lines, or use the drop-in below
#   systemctl --user enable --now agent-memory-watcher
#
# The watcher tails ~/.claude/projects and ~/.codex/sessions, redacts secrets
# locally, and ships session events to the hub over Tailscale. It spools to
# ~/.cache/agent-memory/spool.db while the hub is unreachable and replays on
# reconnect, so it is safe to run on machines that are offline for long stretches.

[Unit]
Description=Agent Memory transcript watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust REPO_DIR to where you cloned the repo.
Environment=REPO_DIR=%h/agent-memory-over-tailscale
Environment=AGENT_MEMORY_URL=http://memory-host.tailnet.ts.net:8787
Environment=AGENT_MEMORY_SHARED_KEY=
# Optional: a stable agent id for this device.
Environment=AGENT_MEMORY_AGENT_ID=%H-watcher
# Optional: colon-separated project paths to never ingest.
Environment=AGENT_MEMORY_DENY=
ExecStart=/usr/bin/env python3 -m watcher.daemon --device %H
WorkingDirectory=%h/agent-memory-over-tailscale
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
